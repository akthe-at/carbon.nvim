  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6D7985",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#85C0C0"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": {
        "foreground": "#B5D86C"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#FFD4C3"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator"],
      "settings": {
        "foreground": "#F07899"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call"],
      "settings": {
        "foreground": "#FFB8AC"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "identifier"],
      "settings": {
        "foreground": "#E0A0C0"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#E0E6C5"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.struct",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#E0E5E8"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.other"],
      "settings": {
        "foreground": "#8179A4"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#FB7388"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.tag"],
      "settings": {
        "foreground": "#FFBE9F"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "#D9DCDD"
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#B3F0EE"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.color", "constant.other.color"],
      "settings": {
        "foreground": "#FB80A0"
      }
    },
    {
      "name": "CSS functions",
      "scope": ["support.function.css", "meta.function-call.css"],
      "settings": {
        "foreground": "#E0E6C5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "markup.heading.entity.name"],
      "settings": {
        "foreground": "#F07899",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#67B474"
      }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#FB80A0"
      }
    },
    {
      "name": "Inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#B5D86C",
        "background": "#6E7475"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#CF4060"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#6D7985",
    "string": "#85C0C0",
    "number": "#FFD4C3",
    "keyword": "#F07899",
    "function": "#FFB8AC",
    "parameter": "#E0E6C5",
    "variable": "#E0A0C0",
    "property": "#B0E0E0",
    "type": "#E0E5E8",
    "class": "#E0E5E8",
    "namespace": "#E0E5E8",
    "enumMember": "#8179A4"
  }
}
