  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8A9199",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#4D8A8A"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": {
        "foreground": "#7B9E3A"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#BF7449"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator"],
      "settings": {
        "foreground": "#C04D6B"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call"],
      "settings": {
        "foreground": "#D08770"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "identifier"],
      "settings": {
        "foreground": "#7B5E99"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#BF7449"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.struct",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#4C566A"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.other"],
      "settings": {
        "foreground": "#7B5E99"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C04D6B"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.tag"],
      "settings": {
        "foreground": "#D08770"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "#8A7B40"
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#6B9A9A"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.color", "constant.other.color"],
      "settings": {
        "foreground": "#C04D6B"
      }
    },
    {
      "name": "CSS functions",
      "scope": ["support.function.css", "meta.function-call.css"],
      "settings": {
        "foreground": "#BF7449"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "markup.heading.entity.name"],
      "settings": {
        "foreground": "#C04D6B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#3D8C48"
      }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#C04D6B"
      }
    },
    {
      "name": "Inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#7B9E3A",
        "background": "#E0D0C0"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#D32F2F"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#8A9199",
    "string": "#4D8A8A",
    "number": "#BF7449",
    "keyword": "#C04D6B",
    "function": "#D08770",
    "parameter": "#BF7449",
    "variable": "#7B5E99",
    "property": "#9E5E8A",
    "type": "#4C566A",
    "class": "#4C566A",
    "namespace": "#4C566A",
    "enumMember": "#7B5E99"
  }
}
