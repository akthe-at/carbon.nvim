  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5D6976",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#73A7A7"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": {
        "foreground": "#A5C25C"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#F2C4B3"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator"],
      "settings": {
        "foreground": "#DB6E89"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call"],
      "settings": {
        "foreground": "#F9B5AC"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "identifier"],
      "settings": {
        "foreground": "#c9cccd"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#D0D6B5"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.struct",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#C9CCCD"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.other"],
      "settings": {
        "foreground": "#716994"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#DB6378"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.tag"],
      "settings": {
        "foreground": "#ffae8f"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "#c9cccd"
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#a3e0de"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.color", "constant.other.color"],
      "settings": {
        "foreground": "#db7090"
      }
    },
    {
      "name": "CSS functions",
      "scope": ["support.function.css", "meta.function-call.css"],
      "settings": {
        "foreground": "#d0d6b5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "markup.heading.entity.name"],
      "settings": {
        "foreground": "#DB6E89",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#57a464"
      }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#db7090"
      }
    },
    {
      "name": "Inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#A5C25C",
        "background": "#5E6465"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#af304a"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#5D6976",
    "string": "#73A7A7",
    "number": "#F2C4B3",
    "keyword": "#DB6E89",
    "function": "#F9B5AC",
    "parameter": "#D0D6B5",
    "variable": "#c9cccd",
    "property": "#9ccccd",
    "type": "#C9CCCD",
    "class": "#C9CCCD",
    "namespace": "#C9CCCD",
    "enumMember": "#716994"
  }
}
